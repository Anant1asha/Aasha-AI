# Aasha-AI Environment Configuration
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to version control.

# =============================================================================
# TIER 1: OpenRouter Free Pool (DEFAULT - All Routine Work)
# Sign up: https://openrouter.ai -> Dashboard -> API Keys
# =============================================================================
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_FREE_MODEL=meta-llama/llama-3.1-8b-instruct:free
FALLBACK_FREE_MODEL_1=nvidia/nemotron-3.5-lightning:free
FALLBACK_FREE_MODEL_2=google/gemini-2.0-flash-exp:free
BATCH_RATE_LIMIT_BACKOFF_MS=3000
MAX_RETRIES_BEFORE_TIER2_ESCALATE=3

# =============================================================================
# TIER 2: Claude Code / Anthropic API (Coding Agent Tasks)
# Get key: https://console.anthropic.com -> API Keys
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
CLAUDE_CODE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_FAST_MODEL=claude-3-haiku-20241022

# =============================================================================
# TIER 3: Gemini API (RESERVE - High-End & Super Admin Tasks ONLY)
# Get key: https://aistudio.google.com -> API Keys
# =============================================================================
# Gemini Key A: Reserve strictly for authorized PDF vision extraction & long-context synthesis
GEMINI_API_KEY_A=AIzaSy-YOUR_KEY_A_HERE

# Gemini Key B: Super Admin deep reasoning, dev-agent multi-agent builds & architecture
GEMINI_API_KEY_B=AIzaSy-YOUR_KEY_B_HERE

# Primary Gemini Key mapping
GEMINI_API_KEY=AIzaSy-YOUR_DEFAULT_OR_KEY_B_HERE

# CRITICAL: Keep this FALSE at all times to prevent paid bleed
ALLOW_PAID_GEMINI_FALLBACK=false

# Authorized task types for Gemini paid API (comma-separated, no spaces)
GEMINI_RESERVE_TASKS=pdf_ingestion,final_qa_certification,super_admin_boost,agent_architecture_build
GEMINI_DEFAULT_RESERVE_MODEL=gemini-2.0-flash
GEMINI_PRO_RESERVE_MODEL=gemini-1.5-pro
GEMINI_VISION_MODEL=gemini-2.0-flash

# =============================================================================
# AASHA Pipeline Config
# =============================================================================
NODE_ENV=development
PORT=3333

MEM0_MODE=local
MEM0_DB_PATH=.scratch/mem0_store.json
GRAPHIFY_OUT_PATH=graphify-out/graph.json

MAX_CHAPTER_FILE_SIZE_MB=20
SHA256_CACHE_ENABLED=true
NETWORK_TIMEOUT_MS=5000

PIPELINE_MODE=B
BATCH_PDF_DIR=content/pdfs/
BATCH_OUTPUT_DIR=content/chapters/

QA_BENCHMARK_MIN_SCORE=100
CDP_VERIFICATION_VIEWPORT=390x844
CDP_DEBUGGING_PORT=9223
