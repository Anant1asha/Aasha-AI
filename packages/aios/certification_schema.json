{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aasha://governance/certification/1.0",
  "title": "AASHA Signed Certification Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","certification_id","artifact_id","artifact_hash","version","source_hash","contract_hash","compiler_version","schema_version_source","test_environment","repair_attempts","verdict","gate_results","certified_at","key_id","signature"],
  "properties": {
    "schema_version": {"const":"1.0"}, "certification_id":{"type":"string","minLength":1}, "artifact_id":{"type":"string","minLength":1},
    "artifact_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"}, "version":{"type":"integer","minimum":1},
    "source_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"}, "contract_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "compiler_version":{"type":"string","minLength":1}, "schema_version_source":{"type":"string","minLength":1}, "test_environment":{"type":"string","minLength":1},
    "repair_attempts":{"type":"integer","minimum":0,"maximum":2}, "verdict":{"const":"PASS"},
    "certified_at":{"type":"string","format":"date-time"}, "key_id":{"type":"string","minLength":1}, "signature":{"type":"string","minLength":16},
    "gate_results":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["gate_id","status","method","environment","timestamp","artifact_hash","evidence_refs"],"properties":{"gate_id":{"type":"string"},"status":{"const":"PASS"},"method":{"type":"string","minLength":1},"environment":{"type":"string","minLength":1},"timestamp":{"type":"string","format":"date-time"},"artifact_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}}}}}
  }
}
