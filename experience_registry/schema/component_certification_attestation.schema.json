{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"aasha://experience-registry/component-certification/1.0",
  "type":"object","additionalProperties":false,
  "required":["schema_version","certification_id","component_id","version","artifact_hash","verdict","issued_at","gate_results","key_id","signature"],
  "properties":{
    "schema_version":{"const":"1.0"},"certification_id":{"type":"string","minLength":1},"component_id":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"artifact_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"verdict":{"const":"PASS"},"issued_at":{"type":"string","format":"date-time"},"key_id":{"type":"string","minLength":1},"signature":{"type":"string","minLength":16},
    "gate_results":{"type":"array","minItems":11,"items":{"type":"object","additionalProperties":false,"required":["gate_id","status","method","environment","timestamp","artifact_hash","evidence_refs"],"properties":{"gate_id":{"type":"string"},"status":{"const":"PASS"},"method":{"type":"string","minLength":1},"environment":{"type":"string","minLength":1},"timestamp":{"type":"string","format":"date-time"},"artifact_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"object","required":["path","sha256"],"properties":{"path":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}}}}}
  }
}
