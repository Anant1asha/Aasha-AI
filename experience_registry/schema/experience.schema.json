{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasha.local/schemas/experience.schema.json",
  "title": "AASHA Experience Registry Entry",
  "type": "object",
  "required": [
    "component_id","version","status","capability_contract","mechanic_tags",
    "dependencies","runtime","provenance","license","verification","artifact_hash","lineage"
  ],
  "additionalProperties": false,
  "properties": {
    "component_id":{"type":"string","pattern":"^exp\\.[a-z0-9._-]+$"},
    "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status":{"enum":["CANDIDATE","VERIFIED","CERTIFIED","BLOCKED","DEPRECATED"]},
    "capability_contract":{"$ref":"capability.schema.json"},
    "mechanic_tags":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "subjects":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "classes":{"type":"array","items":{"type":"integer","minimum":1,"maximum":12},"uniqueItems":true},
    "dependencies":{"type":"array","items":{"type":"object","required":["name","kind"],"additionalProperties":false,"properties":{"name":{"type":"string"},"kind":{"enum":["runtime","build","asset","network"]},"version":{"type":"string"},"local":{"type":"boolean"},"license":{"type":"string"}}}},
    "runtime":{"type":"object","required":["offline_compatible","external_urls"],"additionalProperties":false,"properties":{"offline_compatible":{"type":"boolean"},"external_urls":{"type":"array","items":{"type":"string","format":"uri-reference"}},"minimum_ram_gb":{"type":"number","minimum":0}}},
    "provenance":{"type":"array","items":{"type":"object","required":["source_type","reference"],"additionalProperties":false,"properties":{"source_type":{"enum":["AASHA_NATIVE","OPEN_SOURCE","DERIVED","REFERENCE","UNKNOWN"]},"reference":{"type":"string"},"version":{"type":"string"},"evidence":{"type":"array","items":{"type":"string"}}}}},
    "license":{"type":"object","required":["classification","isolation_mode"],"additionalProperties":false,"properties":{"classification":{"enum":["PERMISSIVE","COPYLEFT","PROPRIETARY","LICENSE_REVIEW_REQUIRED","UNKNOWN"]},"isolation_mode":{"enum":["NATIVE","ADAPTER","SANDBOX","IFRAME","REFERENCE_ONLY","BLOCKED"]},"source_license":{"type":"string"},"review_reference":{"type":"string"}}},
    "verification":{"type":"object","required":["component_gates","evidence_refs"],"additionalProperties":false,"properties":{"component_gates":{"type":"object","additionalProperties":{"enum":["PASS","FAIL","UNKNOWN","NOT_APPLICABLE"]}},"evidence_refs":{"type":"array","items":{"type":"string"}},"chapter_ltruth":{"type":["number","null"],"minimum":0,"maximum":100},"console_errors":{"type":["integer","null"],"minimum":0}}},
    "artifact_hash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "lineage":{"type":"object","additionalProperties":false,"properties":{"derived_from":{"type":"array","items":{"type":"string"}},"supersedes":{"type":"string"},"equivalent_to":{"type":"array","items":{"type":"string"}},"replaced_by":{"type":"string"}}}
  }
}
