{
  "mcpServers": {
    "graphify": {
      "httpUrl": "https://api.graphify.net/mcp",
      "headers": {
        "Authorization": "Bearer ${GRAPHIFY_API_KEY}"
      }
    },
    "a11y-debugging": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-accessibility"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-puppeteer"]
    },
    "memory-leak-debugging": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    }
  }
}